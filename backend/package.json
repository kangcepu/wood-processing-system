    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/platform-socket.io": "11.1.18",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.1.18",
    "@prisma/client": "5.20.0",
    "@wps/contracts": "workspace:*",
    "argon2": "0.41.1",
    "bullmq": "6.3.12",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "minio": "8.0.7",
    "multer": "2.4.0",
