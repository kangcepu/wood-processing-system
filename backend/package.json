    "@types/express": "5.0.5",
    "@types/jest": "29.5.13",
    "@types/multer": "2.0.0",
    "@types/node": "22.7.5",
    "@types/supertest": "7.2.1",
    "@wps/eslint-config": "workspace:*",
    "@wps/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "5.20.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.4",
