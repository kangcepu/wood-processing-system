# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
SITE_TIMEZONE=Asia/Jakarta

# Database
DATABASE_URL=postgresql://wps:wps@localhost:5432/wps

# Access / refresh token
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Cookie / CORS
COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encryption key for settings secrets (base64-encoded 32 bytes)
ENCRYPTION_KEY=replace-with-base64-32-byte-key==

# Redis / background jobs
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# MinIO bootstrap values (actual runtime config is managed via Settings)
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=wps-minio
MINIO_SECRET_KEY=replace-with-a-strong-secret
MINIO_DEFAULT_BUCKET=wps-attachments

# Realtime adapter mode
REALTIME_ADAPTER_MODE=in-process

# External system adapters (mock until Phase 7)
ERPNEXT_ADAPTER_MODE=MOCK
ERPNEXT_BASE_URL=
MCS_ADAPTER_MODE=MOCK
MCS_BASE_URL=
AIMS_ADAPTER_MODE=MOCK
AIMS_BASE_URL=

# Logging
LOG_LEVEL=log

# Legacy Production Dummy data (must stay false outside development/staging)
DUMMY_DATA_ENABLED=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
